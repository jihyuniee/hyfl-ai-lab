---
import Layout from './DataExhibitionLayout.astro';
import Reactions from './DataProjectReactions.astro';
import Browser from './DataProjectBrowser.astro';
import { getProjectStory } from '../lib/project-story.mjs';
import projects from '../data/ai-data-projects.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { classroom = null } = Astro.props;
const allClassrooms = [6, 7, 8, 9, 10];
const works = projects.filter(work => classroom === null || work.classroom === classroom);
const palettes = ['#e4eee7', '#e7eaf5', '#ece4dc', '#dfe9eb'];
---
<Layout gallery title="HYFL AI × DATA 활용대회 · 학생 웹앱 전시관" description="학생들이 발견한 문제, 직접 만든 웹앱. 공공데이터와 AI로 만든 작품을 체험하고 팀의 제작 이야기를 만나 보세요.">
  <section class="gallery-intro" aria-labelledby="gallery-title">
    <div><p class="gallery-eyebrow">2026 · 한영외국어고등학교</p><h1 id="gallery-title">HYFL <span>AI × DATA</span> 활용대회</h1></div>
    <p class="gallery-lead">학생들이 발견한 문제, 직접 만든 웹앱.<br/>마음에 드는 작품을 열어 우리 팀의 이야기를 만나 보세요.</p>
  </section>
  <div class="gallery-toolbar">
    <nav class="class-navigation" aria-label="반별 작품 보기">
      <a href={`${base}/exhibition/ai-data/`} aria-current={classroom === null ? 'page' : undefined}>전체 <span>{projects.length}</span></a>
      {allClassrooms.map(number => <a href={`${base}/exhibition/ai-data/classes/${number}/`} aria-current={classroom === number ? 'page' : undefined}>{number}반 <span>{projects.filter(work => work.classroom === number).length}</span></a>)}
    </nav>
    <p class="gallery-count">{classroom === null ? '전체 작품' : `${classroom}반 작품`} <strong>{works.length}</strong></p>
  </div>
  <section class="work-grid" aria-label={classroom === null ? '학생 웹앱 작품' : `${classroom}반 학생 웹앱 작품`}>
    {works.map(work => {
      const index = projects.findIndex(item => item.id === work.id);
      const href = `${base}/exhibition/ai-data/${work.id}/`;
      const story = getProjectStory(work);
      const profileImage = 'profileImage' in work && typeof work.profileImage === 'string' ? work.profileImage : null;
      const creatorName = work.team || work.title;
      return <article class="work-card" aria-labelledby={`work-${work.id}`}>
        <Browser id={work.id} title={work.title} url={work.url} href={href} eager={index < 4}/>
        <div class="work-body">
        <div class="work-heading-row"><p class="work-app-name">{work.title}</p><span class="work-status">{work.status}</span></div>
        <h2 class="work-intro" id={`work-${work.id}`}><a href={href}>{story?.oneLineIntro || work.question}</a></h2>
        <div class="work-tags">{work.tags.slice(0, 2).map(tag => <span>{tag}</span>)}</div>
        <div class="work-credits"><div class="work-team"><span class="creator-avatar">{profileImage ? <img class="team-avatar" src={`${base}${profileImage}`} alt={`${creatorName} 프로필 사진`} width="44" height="44" loading="lazy"/> : <span class="team-avatar" style={`--avatar-bg:${palettes[index % palettes.length]}`} aria-hidden="true">{creatorName.slice(0, 1)}</span>}</span><div><span class="team-name">{creatorName}</span><span class="creator-members">{work.members.join(' · ')}</span><span class="team-class">2학년 {work.classroom}반{work.teamNumber ? ` · ${work.teamNumber}팀` : ''}</span></div></div><a class="work-launch" href={work.url} target="_blank" rel="noopener noreferrer" aria-label={`${work.title} 웹앱 새 창에서 체험`}>웹앱 체험 ↗</a></div>
        <Reactions projectId={work.id} title={work.title}/>
        </div>
      </article>;
    })}
  </section>
  {works.length === 0 && <div class="gallery-empty"><span aria-hidden="true">↗</span><h2>{classroom}반의 작품을 기다리고 있어요.</h2><p>준비된 팀부터 이곳에서 만나 보세요.</p><a href={`${base}/exhibition/ai-data/`}>전체 작품 둘러보기 →</a></div>}
  <p class="gallery-note">공공데이터와 생성형 AI로 우리 주변의 문제를 해결하는 학생 프로젝트입니다. 다른 팀의 작품도 준비되는 대로 이어서 전시합니다.</p>
</Layout>
<style>
.gallery-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:28px 0 30px}.gallery-eyebrow{font-size:11px;color:#9b91aa;letter-spacing:.035em;margin-bottom:10px}.gallery-intro h1{font-size:clamp(28px,2.7vw,42px);font-weight:700;letter-spacing:-.065em;line-height:1.3;color:#292233}.gallery-intro h1 span{color:#7155b6;letter-spacing:-.04em}.gallery-lead{font-size:12px;color:#92869f;line-height:1.9}.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 0 27px}.class-navigation{display:flex;gap:5px;flex-wrap:wrap}.class-navigation a{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border:1px solid transparent;border-radius:8px;color:#95899f;font-size:12px;text-decoration:none;white-space:nowrap}.class-navigation a:hover{background:#eee8f5;color:#57426d}.class-navigation a[aria-current=page]{background:#7354ad;color:#fff}.class-navigation span{font-size:10px;opacity:.65;font-variant-numeric:tabular-nums}.gallery-count{font-size:11px;color:#a298ac;white-space:nowrap}.gallery-count strong{font-weight:500;color:#685975;margin-left:5px}.work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 32px}.work-card{min-width:0;border:1px solid #e9e2f0;border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 10px 32px #5d39700a;transition:box-shadow .2s}.work-card:hover{box-shadow:0 14px 38px #5d397012}.work-body{padding:21px 25px 16px}.work-heading-row{display:flex;gap:12px;align-items:center;justify-content:space-between}.work-app-name{font-size:12px;color:#9a8ba8;line-height:1.6}.work-status{flex-shrink:0;border:1px solid #e9e2f0;border-radius:4px;color:#a195ac;font-size:9px;padding:3px 6px}.work-intro{font-size:22px;line-height:1.6;letter-spacing:-.045em;font-weight:600;word-break:keep-all;overflow-wrap:anywhere;color:#3a2e47;margin-top:8px;min-height:70px}.work-intro a{text-decoration:none}.work-intro a:hover{color:#7354ad}.work-tags{display:flex;gap:12px;margin-top:12px;font-size:10px;color:#a89bb3}.work-tags span::before{content:'#';margin-right:1px}.work-credits{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:22px}.work-team{display:flex;align-items:center;gap:10px;min-width:0}.creator-avatar{flex-shrink:0}.creator-members{display:block;font-size:12px;line-height:1.7;color:#7f728c;margin-top:3px;word-break:keep-all;overflow-wrap:anywhere}.team-avatar{object-fit:cover;display:grid;place-items:center;flex-shrink:0;width:44px;height:44px;border-radius:50%;background:var(--avatar-bg);font-size:13px;font-weight:700;color:#6d6176;border:3px solid #fff;box-shadow:0 0 0 1px #e9e2f0}.team-name{display:block;font-size:13px;font-weight:600;line-height:1.5;color:#493d56}.team-class{display:block;font-size:10px;color:#a69aae;margin-top:2px}.work-launch{font-size:12px;background:#8b70cb;color:#fff;padding:10px 15px;border-radius:7px;text-decoration:none;white-space:nowrap;box-shadow:0 3px 8px #7550a610}.work-launch:hover{background:#795bb9}.work-card :global(.work-reactions){margin-top:17px}.work-card :global(.reaction-buttons){border-top-color:#f0ebf5;gap:21px}.work-card :global(.reaction-buttons button){font-size:11px;color:#a094ac}.gallery-note{font-size:11px;color:#a89bb3;line-height:1.9;margin-top:37px;max-width:850px}.gallery-empty{padding:65px 20px 80px;text-align:center;border:1px dashed #e0d7e9;border-radius:12px}.gallery-empty>span{font-size:35px;color:#b8a8c6}.gallery-empty h2{font-size:20px;letter-spacing:-.04em;margin:14px 0 8px;color:#675475}.gallery-empty p{font-size:13px;color:#9d8aa9}.gallery-empty a{display:inline-block;margin-top:22px;font-size:12px;color:#806097}@media(min-width:1700px){.work-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}.work-intro{font-size:21px}}@media(max-width:900px){.work-grid{gap:25px 22px}.gallery-intro{align-items:flex-start}.gallery-lead{max-width:260px}.work-body{padding:16px 18px 13px}.work-intro{font-size:18px;min-height:86px}.work-launch{font-size:11px;padding:9px 11px}.team-name{font-size:11px}}@media(max-width:760px){.gallery-intro{display:block;padding:22px 0}.gallery-intro h1{font-size:29px}.gallery-lead{margin-top:13px;max-width:none}.gallery-toolbar{padding-bottom:23px}.gallery-count{display:none}.class-navigation{gap:2px}.class-navigation a{font-size:11px;padding:8px 10px;gap:5px}.work-grid{grid-template-columns:1fr;gap:28px}.work-body{padding:18px 21px 14px}.work-intro{font-size:21px;min-height:0}.work-app-name{font-size:11px}.work-credits{margin-top:19px}.team-name{font-size:12px}.work-launch{font-size:12px;padding:10px 13px}.work-status{font-size:9px}.gallery-note{margin-top:30px}}@media(prefers-reduced-motion:reduce){.work-card{transition:none}}
</style>
