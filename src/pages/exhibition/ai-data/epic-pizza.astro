---
import Layout from '../../../components/DataExhibitionLayout.astro';
import StudentStory from '../../../components/DataProjectStory.astro';
import { getProjectStory } from '../../../lib/project-story.mjs';
import VoteButton from '../../../components/DataVoteButton.astro';
import Preview from '../../../components/DataProjectPreview.astro';
import projects from '../../../data/ai-data-projects.json';
const work = projects.find(project => project.id === 'epic-pizza')!;
const story = getProjectStory(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="길온 · 에픽피자 | AI × DATA 프로젝트 전시관" description="9반 에픽피자 팀이 송파구 CCTV 공공데이터로 경로 주변의 카메라를 비교하는 길온을 만든 과정을 소개합니다.">
{story ? <StudentStory work={work} story={story}/> : <>

  <a class="back-link" href={`${base}/exhibition/ai-data/`}>← 9반 프로젝트 목록으로</a>
  <section class="work-heading">
    <div><p class="eyebrow">AI × DATA · 2학년 9반 · {work.team}<span class="status">{work.status}</span></p><h1>{work.title}</h1><p class="subtitle">{work.subtitle}</p><p class="student-question">{work.question}</p></div>
    <div><p class="team-members"><strong>김도희</strong> · 팀장·아이디어·UI 디자인<br/><strong>유현서</strong> · 자료 조사·활동지 작성<br/><strong>김민수</strong> · 웹앱 설계·구현·배포</p><div class="actions"><a class="primary" href={work.url} target="_blank" rel="noopener noreferrer">웹앱 직접 사용하기 ↗</a></div></div>
  </section>
  <Preview id={work.id} url={work.url} title={work.title}/>
  <nav class="work-contents" aria-label="프로젝트 소개"><a href="#problem">01 우리 팀의 문제</a><a href="#data">02 공공데이터 활용</a><a href="#demo">03 사용 예시</a><a href="#verification">04 검증과 개선</a></nav>

  <section class="record-section" id="problem">
    <div><p class="section-number">01 · 문제와 사용자</p><h2>우리 팀이 정한 문제</h2></div>
    <div class="section-body"><p>밤늦게 귀가하는 학생·직장인·지역 주민이 주변 방범 시설의 위치를 미리 확인하기 어렵다는 문제에 주목했습니다. 송파구 CCTV를 지도에서 살펴보고, 출발지와 도착지 사이의 경로를 비교할 수 있도록 만들었습니다.</p><p>처음에는 방범 시설의 부족에 관심을 가졌고, 이후 시설이 어디에 있는지 알기 어렵다는 문제까지 포함해 웹앱의 방향을 구체화했습니다.</p></div>
  </section>

  <section class="record-section" id="data">
    <div><p class="section-number">02 · 공공데이터 활용</p><h2>위치 데이터를<br/>경로 비교 기능으로</h2></div>
    <div class="section-body">
      <p>주제 탐색에는 안심귀갓길·인구·이동편의시설 자료를 조사했고, 현재 웹앱에는 <strong>송파구 CCTV의 위치·설치 목적·카메라 대수</strong>를 직접 활용했습니다. 경로와 CCTV 사이의 거리를 계산해 설정한 반경 안의 카메라 대수와 지점 수를 보여 줍니다.</p>
      <table class="evidence-table"><thead><tr><th scope="col">자료</th><th scope="col">우리 팀의 활용</th></tr></thead><tbody>
        <tr><td>서울특별시 CCTV 정보 파일 중 송파구 자료</td><td>좌표·설치 목적·대수를 지도 표시와 경로별 집계에 활용합니다. 웹앱의 출처 표시 기준일은 2026-05-01이며, 원문 링크는 추가 확인이 필요합니다.</td></tr>
        <tr><td>송파구 여성 안심 귀갓길·KOSIS 주민등록인구</td><td>귀가 수요와 시설 분포를 살펴보는 자료로 조사했습니다. 현재 앱에는 안심귀갓길 구간이나 동별 인구를 표시하는 기능이 포함되어 있지 않습니다.</td></tr>
        <tr><td>국토교통부 교통약자 이동편의시설 현황</td><td>전국 단위 비율 자료의 구조를 확인했습니다. 송파구의 개별 장애물 위치를 표시하기에는 추가 자료가 필요하다고 정리했습니다.</td></tr>
      </tbody></table>
      <p>입력한 두 지점 사이의 경로 후보를 비교해 <strong>확인된 CCTV가 가장 많은 경로</strong>를 표시합니다. 거리와 1km당 카메라 대수도 함께 보여 주며, 설치 목적·집계 반경·중복 행 처리 여부를 선택할 수 있습니다.</p>
      <h3>AI에게 도움받은 일과 우리 팀이 결정한 것</h3>
      <p>자료 구조 정리와 HTML·CSS·JavaScript 구현·오류 수정을 생성형 AI에게 요청했습니다. 우리 팀은 카메라 대수를 지도 위 점 안에 표시하고, 확대·축소를 세밀하게 조정하며, 긴 안내를 ‘더보기’로 접는 방식을 선택했습니다.</p>
    </div>
  </section>

  <section class="record-section" id="demo">
    <div><p class="section-number">03 · 사용 예시</p><h2>직접 경로를 비교해 보세요</h2></div>
    <div class="section-body">
      <ol class="feature-list"><li>웹앱을 열고 출발지에 <strong>롯데월드</strong>, 도착지에 <strong>올림픽공원</strong>을 입력합니다.</li><li>용도는 <strong>생활방범</strong>, 반경은 <strong>30m</strong>로 두고 <strong>경로 찾기</strong>를 누릅니다.</li><li>경로별 거리·CCTV 대수·지점 수를 비교하고, 경로를 선택해 지도 위 위치를 확인합니다.</li></ol>
      <p class="small">주소 검색과 경로 계산에는 외부 서비스를 사용합니다. 연결에 실패하면 도로 경로나 직선으로 대체될 수 있으므로, ‘안내 더보기’에서 경로 종류를 함께 확인합니다.</p>
      <div class="actions"><a class="secondary" href={work.url} target="_blank" rel="noopener noreferrer">길온 열기 ↗</a></div>
    </div>
  </section>

  <section class="record-section" id="verification">
    <div><p class="section-number">04 · 검증과 개선</p><h2>확인한 결과와<br/>앞으로 개선할 점</h2></div>
    <div class="section-body">
      <h3>활동지에 남긴 검증 기록</h3>
      <p>팀은 STEP 3-2에서 다음 세 입력의 원자료 값과 웹앱 결과가 일치했다고 기록했습니다.</p>
      <table class="evidence-table"><thead><tr><th scope="col">테스트 입력</th><th scope="col">팀이 기록한 대조 결과</th></tr></thead><tbody><tr><td>롯데월드 → 올림픽공원</td><td>17대 · 5곳 · 일치로 기록</td></tr><tr><td>올림픽공원 → 몽촌토성</td><td>10대 · 2곳 · 일치로 기록</td></tr><tr><td>잠실야구장 → 롯데월드</td><td>22대 · 7곳 · 일치로 기록</td></tr></tbody></table>
      <p class="note">전시 준비 중 2026-11-05에 첫 입력을 생활방범·반경 30m·중복 행 제외 해제 조건으로 실행했을 때에는 10대·2곳과 38대·12곳의 두 경로가 표시되었습니다. 활동지 기록과 차이가 있어 출발·도착 좌표, 경로 후보, 집계 조건을 맞춰 다시 대조할 필요가 있습니다. 원자료의 정확성을 별도로 검증한 결과는 아닙니다.</p>
      <h3>직접 써 보고 고친 점</h3>
      <p>팀원들이 사용하며 지도 확대·축소가 크게 바뀌는 점과 안내 문구가 많은 점을 확인했습니다. 확대·축소 간격을 0.25로 조정하고, 긴 설명은 ‘더보기’로 접어 화면을 정리했습니다.</p>
      <h3>남은 한계와 개선 방향</h3>
      <p>CCTV 대수만으로 실제 안전도를 단정할 수는 없습니다. 시설의 작동 상태, 범죄 발생 위험, 야간 유동 인구는 위치 자료만으로 확인하기 어렵고, 데이터 기준일과 실제 현황에도 차이가 있을 수 있습니다.</p>
      <p>현재 구현의 중심은 CCTV 위치와 경로별 집계입니다. 설계 단계에서 구상한 AI 안전도 예측과 비상벨·보안등 위치 표시는 추가 구현이 필요합니다. 112 연결 버튼은 휴대폰에서 실제 발신 화면이 열리는지 확인되지 않았습니다.</p>
      <p>팀은 범죄 발생 통계·야간 유동 인구·가로등 밝기 자료를 추가하고, 위험 구간이나 고장 난 시설물을 사용자가 제보하는 기능으로 확장하고 싶다고 정리했습니다.</p>
    </div>
  </section>
  <div class="actions"><VoteButton projectId={work.id} title={work.title}/></div>
<div class="project-nav-next"><p>팀 활동지와 현재 웹앱을 바탕으로 정리했습니다.<br/>팀의 검증 기록과 전시 준비 중 확인한 결과를 구분해 소개합니다.</p><a href={`${base}/data-project/`}>이 프로젝트의 수업 보기 ↗</a></div>
</>}
</Layout>
