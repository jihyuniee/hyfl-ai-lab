---
interface Props {
	eyebrow: string;
	title: string;
	tagline: string;
	ctaLabel: string;
	ctaHref: string;
}
const { eyebrow, title, tagline, ctaLabel, ctaHref } = Astro.props;
---

<section class="lab-hero">
	<p class="lab-hero__eyebrow">{eyebrow}</p>
	<h1 class="lab-hero__title">{title}</h1>
	<p class="lab-hero__tagline">{tagline}</p>
	<a class="lab-hero__cta" href={ctaHref}>{ctaLabel} →</a>
</section>

<style>
	.lab-hero {
		padding: clamp(2rem, 5vw, 3.5rem);
		margin-bottom: 1rem;
		border: 1px solid var(--lab-border);
		border-top: 5px solid var(--sl-color-accent);
		border-radius: var(--lab-radius-lg);
		background: var(--lab-gradient-hero);
	}

	.lab-hero__eyebrow {
		margin: 0 0 0.75rem;
		color: var(--sl-color-accent);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.lab-hero__title {
		margin: 0;
		color: var(--sl-color-white);
		font-size: clamp(2rem, 1.65rem + 1.6vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.lab-hero__tagline {
		max-width: 42rem;
		margin: 1rem 0 1.5rem;
		color: var(--sl-color-gray-2);
		font-size: 1.02rem;
		line-height: 1.7;
	}

	.lab-hero__cta {
		display: inline-flex;
		align-items: center;
		min-height: 2.7rem;
		padding: 0.65rem 1rem;
		border-radius: 7px;
		background: var(--sl-color-accent);
		color: #ffffff;
		font-weight: 700;
		text-decoration: none;
	}

	.lab-hero__cta:hover {
		background: var(--sl-color-accent-high);
	}

	@media (max-width: 30rem) {
		.lab-hero {
			padding: 1.5rem 1.2rem;
		}
	}
</style>
