---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="exhibition-header">
  <a class="exhibition-brand" href={`${base}/exhibition/`}>
    <span>인공지능 원리탐구</span>
    <span class="exhibition-label">프로젝트 전시관</span>
  </a>
  <a class="textbook-link" href={`${base}/`}>교과서 보기 ↗</a>
</header>
<style>
.exhibition-header{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px 0;border-bottom:1px solid #e8e2ef}
.exhibition-brand{display:flex;align-items:center;gap:14px;min-width:0;color:#292233;font-size:19px;font-weight:700;line-height:1.5;letter-spacing:-.04em;text-decoration:none}
.exhibition-label{border-left:1px solid #ded7e6;padding-left:14px;color:#81748e;font-size:12px;font-weight:500;letter-spacing:-.02em}
.textbook-link{flex-shrink:0;color:#81748e;font-size:12px;line-height:1.6;text-decoration:none}
.exhibition-brand:hover,.textbook-link:hover{color:#7354ad}
.exhibition-brand:focus-visible,.textbook-link:focus-visible{outline:2px solid #7354ad;outline-offset:4px}
@media(max-width:600px){.exhibition-header{gap:16px;padding:13px 0}.exhibition-brand{flex-direction:column;align-items:flex-start;gap:2px;font-size:17px}.exhibition-label{border:0;padding:0;font-size:10px}.textbook-link{font-size:11px}}
</style>
