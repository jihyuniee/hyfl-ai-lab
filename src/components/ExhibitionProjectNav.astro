---
interface Props { active: 'model' | 'data' }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="exhibition-projects" aria-label="프로젝트 선택">
  <a href={`${base}/exhibition/school-image-lab/`} aria-current={active === 'model' ? 'page' : undefined}><span>프로젝트 1</span>머신러닝 분류 모델</a>
  <a href={`${base}/exhibition/ai-data/`} aria-current={active === 'data' ? 'page' : undefined}><span>프로젝트 2</span>공공데이터 웹앱</a>
</nav>
<style>
.exhibition-projects{display:flex;align-items:stretch;gap:34px;padding:18px 0 0;border-bottom:1px solid #e8e8e8}
.exhibition-projects a{display:flex;flex-direction:column;gap:6px;padding:0 3px 15px;border-bottom:2px solid transparent;font-size:14px;line-height:1.6;font-weight:500;color:#686b72;text-decoration:none;word-break:keep-all}
.exhibition-projects a>span{font-size:10px;font-weight:400;color:#92959b}
.exhibition-projects a:hover{color:#354b9f;border-bottom-color:#c4cade}
.exhibition-projects a[aria-current=page]{color:#354b9f;border-bottom-color:#354b9f}
.exhibition-projects a:focus-visible{outline:2px solid #354b9f;outline-offset:4px}
@media(max-width:600px){.exhibition-projects{gap:25px;padding-top:15px}.exhibition-projects a{font-size:12px;gap:5px;padding-bottom:13px}.exhibition-projects a>span{font-size:10px}}
</style>
