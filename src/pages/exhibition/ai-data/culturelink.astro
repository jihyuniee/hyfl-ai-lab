---
import Layout from '../../../components/DataExhibitionLayout.astro';
import StudentStory from '../../../components/DataProjectStory.astro';
import TeamPhoto from '../../../components/TeamProfilePhoto.astro';
import { getProjectStory } from '../../../lib/project-story.mjs';
import VoteButton from '../../../components/DataVoteButton.astro';
import Preview from '../../../components/DataProjectPreview.astro';
import projects from '../../../data/ai-data-projects.json';
const work = projects.find(project => project.id === 'culturelink')!;
const story = getProjectStory(work);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const profileImage = 'profileImage' in work && typeof work.profileImage === 'string' ? work.profileImage : null;
---
<Layout title="컬처링크 · 주민문화 | AI × DATA 프로젝트 전시관" description="저희 주민문화 팀이 만든 컬처링크를 소개합니다. 지역별 문화시설을 살펴보고 문화공간 기획을 연결합니다.">
{story ? <StudentStory work={work} story={story}/> : <>

<a class="back-link" href={`${base}/exhibition/ai-data/`}>← 프로젝트 목록으로</a>
<section class="work-heading">
<div><p class="eyebrow">AI × DATA · 2학년 7반 · {work.team}<span class="status">{work.status}</span></p><h1>{work.title}</h1><p class="subtitle">{work.subtitle}</p><p class="student-question">{work.question}</p></div>
<div><div class="team-identity">{profileImage && <TeamPhoto id={work.id} name={work.team || work.title} src={`${base}${profileImage}`} size={66}/>}<p class="team-members"><strong>윤주은</strong> · 사용자 흐름·기능 설계·웹앱 제작·배포<br/><strong>정민제</strong> · 공공데이터 수집·분석·해결 방향 구상</p></div><div class="actions"><a class="primary" href={work.url} target="_blank" rel="noopener noreferrer">웹앱 직접 사용하기 ↗</a></div></div>
</section>
<Preview id={work.id} url={work.url} title={work.title}/>
<nav class="work-contents" aria-label="프로젝트 소개"><a href="#problem">01 우리 팀의 문제</a><a href="#data">02 공공데이터 활용</a><a href="#demo">03 사용 예시</a><a href="#verification">04 검증과 개선</a></nav>
<section class="record-section" id="problem"><div><p class="section-number">01 · 문제와 사용자</p><h2>지역에 따라 달라지는<br/>문화 경험의 기회</h2></div><div class="section-body">
<p>저희는 다른 지역에 사는 친구들이 문화생활을 위해 오랜 시간 이동한다는 경험에서 출발했습니다. 지역별 문화시설의 수와 종류를 살펴보고, 거주 지역에 따라 문화 경험의 기회가 어떻게 달라질 수 있는지 탐구했습니다.</p>
<p>처음에는 문화시설 격차를 시각화하는 앱을 구상했습니다. 이후 <strong>문화공간을 만들려는 기획자와 투자자·공공기관을 연결하는 프로젝트 커뮤니티</strong>로 방향을 발전시켰습니다. 팀명 ‘주민문화’에는 주민 누구나 문화를 누리기를 바라는 뜻과 두 팀원의 이름을 담았습니다.</p>
</div></section>
<section class="record-section" id="data"><div><p class="section-number">02 · 공공데이터 활용</p><h2>시설 수에서 출발해<br/>유형별 분포 살펴보기</h2></div><div class="section-body">
<p>저희는 시설 총수만으로 문화 접근성을 설명하기 어렵다고 보았습니다. 공공 문화시설과 영화관 등 시설 유형별 분포, 인구 대비 시설 수를 함께 살펴보며 처음의 문제 인식을 구체화했습니다.</p>
<table class="evidence-table"><thead><tr><th scope="col">조사한 자료</th><th scope="col">활용 방식</th></tr></thead><tbody>
<tr><td>지역문화통합정보시스템 · 지역별 시설종류별 문화시설 수</td><td>시설 유형별 지역 분포와 수도권·비수도권의 차이를 살펴보는 근거로 활용했습니다.</td></tr>
<tr><td>문화체육관광부 · 2025 전국 문화기반시설 자료</td><td>인구 대비 시설 수를 비교하고, 현재 앱에서는 기관·시설 이름과 주소를 검색하는 내장 데이터로 활용했습니다. 앱의 기준일 표시는 2025-01-01입니다.</td></tr>
<tr><td>영화진흥위원회 · 2025년 전국극장조사</td><td>공공 문화시설과 영화관의 지역별 분포를 비교하는 탐구 자료로 활용했습니다.</td></tr>
<tr><td>KOSIS · 권역별 백화점 수(2016~2019년)</td><td>민간시설 분포를 조사하는 과정에서 참고했습니다. 다른 자료와 기준연도가 다릅니다.</td></tr>
</tbody></table>
<p>위 자료는 저희가 활동지에 정리한 제목과 기관을 기준으로 소개합니다. 원자료 파일과 개별 수치를 모두 대조하는 작업은 아직 남아 있습니다. 자료마다 집계 범위와 기준연도가 달라 각각 구분해 살펴보았습니다.</p>
<h3>AI에게 도움받고 직접 결정한 것</h3><p>생성형 AI에 주제 탐색, 데이터 수집 경로, HTML·JavaScript 코드 작성과 수정을 요청했습니다. 저희가 직접 파일을 실행해 보고, AI가 제시한 지도를 카카오맵 연결로 바꾸었습니다. 시설 검색과 기획서 검색 등 이용자에게 필요한 기능도 구체화했습니다.</p>
</div></section>
<section class="record-section" id="demo"><div><p class="section-number">03 · 사용 예시</p><h2>시설을 찾고<br/>문화공간 제안 살펴보기</h2></div><div class="section-body">
<ol class="feature-list"><li><strong>지역·시설 데이터</strong>에서 기관·시설 검색에 ‘국립중앙도서관’을 입력하고 기관 검색을 누릅니다. 이름·유형·지역·주소를 확인할 수 있습니다.</li><li><strong>프로젝트 커뮤니티</strong>에서 시·도, 시설 유형, 진행 단계와 검색어로 기획서를 탐색합니다. 초기 화면의 기획서는 ‘시연용 예시’로 표시되어 있습니다.</li><li><strong>기획서 등록</strong>에서 프로젝트명·지역·시설 유형·사업 규모·기획 개요와 파일 첨부 항목을 살펴봅니다. 체험에는 실제 연락처 대신 가상 정보를 사용하세요.</li></ol>
<p>투자자 등록·목록·연락함 화면도 구성했습니다. 현재는 브라우저의 IndexedDB에 정보를 저장합니다. 서로 다른 기기에서 기획서와 연락 요청을 공유하는 기능은 아직 마련하지 못했습니다.</p>
<div class="actions"><a class="secondary" href={work.url} target="_blank" rel="noopener noreferrer">컬처링크 열기 ↗</a></div>
</div></section>
<section class="record-section" id="verification"><div><p class="section-number">04 · 검증과 개선</p><h2>만들며 확인하고<br/>다음 단계로 남긴 것</h2></div><div class="section-body">
<h3>직접 써 보고 고친 점</h3><p>저희는 기획서 게시, 투자자 등록, 시설 이름과 위치 검색 기능을 만들고 작동 여부를 활동지에 기록했습니다. 기획 개요의 글자 수 제한을 늘리고, 원하는 분야의 기획서를 찾을 수 있도록 검색 기능을 추가했습니다.</p>
<h3>현재 웹앱에서 확인한 범위</h3><p>2026-11-09에 ‘국립중앙도서관’을 검색했을 때 검색 결과 1개와 서울특별시 서초구 반포대로 201이라는 주소가 표시되었습니다. 기획서 등록 화면의 텍스트·파일 입력 항목과 시연용 기획서도 확인했습니다. 이 실행 예시는 검색과 입력 화면을 확인한 범위입니다. 실제 게시·연락 요청의 전송, 지도 위치의 정확성, 원자료 수치 전체의 일치 여부는 추가 점검이 필요합니다.</p>
<p>앱은 내장 데이터 3,551개를 표시하며 지역 선택 항목에는 ‘광역 합계’·‘기초 합계’도 포함되어 있습니다. 실제 개별 시설 수를 정확하게 안내하려면 집계 행과 중복 여부를 더 확인해야 합니다.</p>
<h3>남은 한계와 개선 방향</h3><p>시설 수만으로 주민 수요, 이동 편의, 운영 프로그램이나 사업성을 단정할 수 없습니다. 저희는 주민 수요 조사와 임대료·유동 인구·주민 선호도 같은 정보를 더 살펴볼 필요가 있다고 생각합니다.</p>
<p>앞으로 AI 기획서 분석과 투자자·공공기관 지원 연계로 발전시키고 싶습니다. 실제 AI 분석과 투자·지원 연결은 아직 구현하지 못했습니다. 여러 사용자가 함께 이용하려면 공유 저장소와 이용자 확인, 연락 정보 접근 권한도 마련해야 합니다.</p>
</div></section>
<div class="actions"><VoteButton projectId={work.id} title={work.title}/></div>
<div class="project-nav-next"><p>저희가 관심을 가진 문제와 만들어 가는 과정을 소개했습니다.<br/>컬처링크를 둘러보시고 의견을 남겨 주세요.</p><a href={`${base}/data-project/`}>이 프로젝트의 수업 보기 ↗</a></div>
</>}
</Layout>
<style>
.team-identity{display:flex;align-items:center;gap:14px}
</style>
