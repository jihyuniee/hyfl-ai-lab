---
import Layout from './DataExhibitionLayout.astro';
import Reactions from './DataProjectReactions.astro';
import projects from '../data/ai-data-projects.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { classroom = null } = Astro.props;
const allClassrooms = [6, 7, 8, 9, 10];
const works = projects.filter(work => classroom === null || work.classroom === classroom);
const palettes = ['#e4eee7', '#e7eaf5', '#ece4dc', '#dfe9eb'];
---
<Layout gallery title="HYFL AI × DATA 활용대회 · 학생 웹앱 전시관" description="학생들이 발견한 문제, 직접 만든 웹앱. 공공데이터와 AI로 만든 작품을 체험하고 팀의 제작 이야기를 만나 보세요.">
  <section class="gallery-intro" aria-labelledby="gallery-title">
    <div><p class="gallery-eyebrow">2026 · 한영외국어고등학교</p><h1 id="gallery-title">HYFL <span>AI × DATA</span> 활용대회</h1></div>
    <p class="gallery-lead">학생들이 발견한 문제, 직접 만든 웹앱.<br/>마음에 드는 작품을 열어 우리 팀의 이야기를 만나 보세요.</p>
  </section>
  <div class="gallery-toolbar">
    <nav class="class-navigation" aria-label="반별 작품 보기">
      <a href={`${base}/exhibition/ai-data/`} aria-current={classroom === null ? 'page' : undefined}>전체 <span>{projects.length}</span></a>
      {allClassrooms.map(number => <a href={`${base}/exhibition/ai-data/classes/${number}/`} aria-current={classroom === number ? 'page' : undefined}>{number}반 <span>{projects.filter(work => work.classroom === number).length}</span></a>)}
    </nav>
    <p class="gallery-count">{classroom === null ? '전체 작품' : `${classroom}반 작품`} <strong>{works.length}</strong></p>
  </div>
  <section class="work-grid" aria-label={classroom === null ? '학생 웹앱 작품' : `${classroom}반 학생 웹앱 작품`}>
    {works.map(work => {
      const index = projects.findIndex(item => item.id === work.id);
      const href = `${base}/exhibition/ai-data/${work.id}/`;
      return <article class="work-card" aria-labelledby={`work-${work.id}`}>
        <a class="work-cover" href={href} style={`--cover-bg:${palettes[index % palettes.length]}`} aria-label={`${work.title} 작품과 제작 이야기 보기`}>
          <img src={`${base}/exhibition/ai-data/covers/${work.id}.webp`} alt={`${work.title} 웹앱의 실제 첫 화면`} width="1200" height="824" loading={index < 4 ? 'eager' : 'lazy'} decoding="async"/>
          <span class="cover-caption">작품 이야기 보기 <span aria-hidden="true">↗</span></span>
        </a>
        <div class="work-heading-row"><h2 id={`work-${work.id}`}><a href={href}>{work.title}</a></h2><span class="work-status">{work.status}</span></div>
        <p class="work-question">{work.question}</p>
        <div class="work-tags">{work.tags.slice(0, 2).map(tag => <span>{tag}</span>)}</div>
        <div class="work-credits"><div class="work-team"><span class="team-avatar" style={`--avatar-bg:${palettes[index % palettes.length]}`} aria-hidden="true">{work.team.slice(0, 1)}</span><div><span class="team-name">{work.team}</span><span class="team-class">2학년 {work.classroom}반{work.teamNumber ? ` · ${work.teamNumber}팀` : ''}</span></div></div><a class="work-launch" href={work.url} target="_blank" rel="noopener noreferrer" aria-label={`${work.title} 웹앱 새 창에서 체험`}>웹앱 체험 ↗</a></div>
        <Reactions projectId={work.id} title={work.title}/>
      </article>;
    })}
  </section>
  {works.length === 0 && <div class="gallery-empty"><span aria-hidden="true">↗</span><h2>{classroom}반의 작품을 기다리고 있어요.</h2><p>준비된 팀부터 이곳에서 만나 보세요.</p><a href={`${base}/exhibition/ai-data/`}>전체 작품 둘러보기 →</a></div>}
  <p class="gallery-note">공공데이터와 생성형 AI로 우리 주변의 문제를 해결하는 학생 프로젝트입니다. 다른 팀의 작품도 준비되는 대로 이어서 전시합니다.</p>
</Layout>
<style>
.gallery-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding:29px 0 28px}.gallery-eyebrow{font-size:11px;color:#777;letter-spacing:.035em;margin-bottom:10px}.gallery-intro h1{font-size:clamp(26px,2.45vw,42px);font-weight:700;letter-spacing:-.065em;line-height:1.25;color:#191919}.gallery-intro h1 span{letter-spacing:-.04em}.gallery-lead{font-size:12px;color:#6b6b6b;line-height:1.9;padding-bottom:1px}.gallery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 0 24px}.class-navigation{display:flex;gap:5px;flex-wrap:wrap}.class-navigation a{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border:1px solid transparent;border-radius:7px;color:#707070;font-size:12px;text-decoration:none;white-space:nowrap}.class-navigation a:hover{background:#efefef;color:#111}.class-navigation a[aria-current=page]{background:#202020;color:#fff}.class-navigation span{font-size:10px;opacity:.65;font-variant-numeric:tabular-nums}.gallery-count{font-size:11px;color:#888;white-space:nowrap}.gallery-count strong{font-weight:500;color:#222;margin-left:5px}.work-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:34px 22px}.work-card{min-width:0}.work-cover{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:4/3;overflow:hidden;background:var(--cover-bg);border-radius:5px;text-decoration:none;padding:21px 14px}.work-cover img{width:100%;height:auto;max-height:100%;object-fit:contain;box-shadow:0 8px 22px #00000012;transition:transform .25s ease}.work-cover:hover img,.work-cover:focus-visible img{transform:scale(1.035)}.cover-caption{position:absolute;inset:auto 10px 10px auto;background:#fffffff5;padding:7px 10px;border-radius:4px;box-shadow:0 2px 8px #0000000c;font-size:10px;opacity:0;transform:translateY(4px);transition:.2s}.cover-caption>span{margin-left:5px}.work-cover:hover .cover-caption,.work-cover:focus-visible .cover-caption{opacity:1;transform:none}.work-heading-row{display:flex;gap:8px;align-items:flex-start;justify-content:space-between;margin-top:16px}.work-heading-row h2{font-size:18px;line-height:1.4;letter-spacing:-.045em;font-weight:650}.work-heading-row h2 a{text-decoration:none}.work-heading-row h2 a:hover{text-decoration:underline;text-underline-offset:4px}.work-status{flex-shrink:0;border:1px solid #d9d9d9;border-radius:3px;color:#777;font-size:9px;padding:3px 5px;margin-top:1px}.work-question{font-size:12px;line-height:1.85;color:#666;margin-top:8px;min-height:44px;word-break:keep-all;overflow-wrap:anywhere}.work-tags{display:flex;gap:10px;margin-top:10px;font-size:10px;color:#888}.work-tags span::before{content:'#';margin-right:1px}.work-credits{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:17px}.work-team{display:flex;align-items:center;gap:8px;min-width:0}.team-avatar{display:grid;place-items:center;flex-shrink:0;width:27px;height:27px;border-radius:50%;background:var(--avatar-bg);font-size:11px;font-weight:700;color:#3d4548}.team-name{display:block;font-size:11px;font-weight:650;line-height:1.4}.team-class{display:block;font-size:9px;color:#909090;margin-top:2px}.work-launch{font-size:10px;color:#666;text-decoration:none;white-space:nowrap}.work-launch:hover{color:#111;text-decoration:underline;text-underline-offset:3px}.gallery-note{font-size:11px;color:#888;line-height:1.9;margin-top:37px;max-width:850px}.gallery-empty{padding:65px 20px 80px;text-align:center;border:1px dashed #ddd;border-radius:6px}.gallery-empty>span{font-size:35px;color:#aaa}.gallery-empty h2{font-size:20px;letter-spacing:-.04em;margin:14px 0 8px}.gallery-empty p{font-size:13px;color:#777}.gallery-empty a{display:inline-block;margin-top:22px;font-size:12px;color:#555}@media(min-width:1600px){.work-grid{gap:38px 24px}.work-heading-row h2{font-size:21px}.work-question{font-size:13px}.work-cover{padding:27px 18px}}@media(max-width:1099px){.work-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 24px}.gallery-intro{align-items:flex-start}.gallery-lead{max-width:280px}.work-heading-row h2{font-size:20px}}@media(max-width:760px){.gallery-intro{display:block;padding:22px 0}.gallery-intro h1{font-size:29px}.gallery-lead{margin-top:13px;max-width:none}.gallery-toolbar{align-items:flex-end;gap:8px;padding-bottom:20px}.gallery-count{display:none}.class-navigation{gap:2px}.class-navigation a{font-size:11px;padding:8px 10px;gap:5px}.work-grid{gap:31px 17px}.work-cover{padding:15px 10px}.work-heading-row{margin-top:13px;flex-wrap:wrap;gap:5px}.work-heading-row h2{font-size:17px}.work-status{font-size:8px}.work-question{font-size:11px;min-height:61px}.work-credits{align-items:flex-start;flex-wrap:wrap;gap:10px}.work-launch{margin-left:35px}.work-tags{font-size:9px;gap:7px}.team-name{font-size:10px}.gallery-note{margin-top:30px}}@media(max-width:480px){.work-grid{grid-template-columns:1fr}.work-cover{padding:23px 17px}.work-heading-row{flex-wrap:nowrap}.work-heading-row h2{font-size:20px}.work-question{font-size:13px;min-height:0}.work-credits{align-items:center;flex-wrap:nowrap}.work-launch{margin-left:0;font-size:11px}.team-name{font-size:12px}.team-class{font-size:10px}.work-tags{font-size:11px}.work-status{font-size:10px}.work-credits{margin-top:16px}}@media(prefers-reduced-motion:reduce){.work-cover img,.cover-caption{transition:none}}
</style>
