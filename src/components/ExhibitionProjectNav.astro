---
interface Props { active: 'model' | 'data' }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="exhibition-projects" aria-label="프로젝트별 작품집">
<a href={`${base}/exhibition/school-image-lab/`} aria-current={active === 'model' ? 'page' : undefined}><span>프로젝트 1</span> 머신러닝 분류 모델</a>
<a href={`${base}/exhibition/ai-data/`} aria-current={active === 'data' ? 'page' : undefined}><span>프로젝트 2</span> 공공데이터 웹앱</a>
</nav>
<style>
.exhibition-projects{display:flex;flex-wrap:wrap;gap:24px;padding:16px 0 10px;border-bottom:1px solid #e8e2ef;font-size:13px;line-height:1.5}
.exhibition-projects a{display:inline-flex;align-items:baseline;gap:7px;padding:4px 0 8px;border-bottom:2px solid transparent;color:#8a7e96;text-decoration:none}
.exhibition-projects span{font-size:11px;opacity:.75}
.exhibition-projects a:hover{color:#7354ad}
.exhibition-projects a[aria-current=page]{color:#7354ad;font-weight:700;border-bottom-color:#7354ad}
.exhibition-projects a:focus-visible{outline:2px solid #7354ad;outline-offset:4px}
@media(max-width:600px){.exhibition-projects{gap:18px;font-size:12px}.exhibition-projects a{flex-direction:column;gap:3px}.exhibition-projects span{font-size:10px}}
</style>
