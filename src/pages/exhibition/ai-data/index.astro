---
import Layout from '../../../components/DataExhibitionLayout.astro';
import projects from '../../../data/ai-data-projects.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const classes = [...new Set(projects.map(p => p.classroom))].sort((a,b)=>a-b);
---
<Layout title="HYFL AI × DATA 프로젝트 모음" description="공공데이터와 생성형 AI로 만든 팀별 웹앱과 제작 과정을 소개합니다.">
<section class="book-intro"><p class="eyebrow">한영외국어고등학교 · 2026 · 두 번째 프로젝트</p><h1>HYFL AI × DATA</h1><p class="lead">우리 팀의 웹앱과 제작 이야기<br/>공공데이터에서 발견한 문제를 사용자를 돕는 기능으로 연결합니다.</p><div class="actions"><a class="primary" href={`${base}/exhibition/ai-data/submit/`}>우리 팀 프로젝트 제출 →</a></div></section>
<nav class="work-contents" aria-label="반별 목록">{classes.map(n=><a href={`#class-${n}`}>{n}반 · {projects.filter(p=>p.classroom===n).length}팀</a>)}</nav>
{projects.length === 0 && <p class="lead">공개된 프로젝트가 아직 없습니다.</p>}
{classes.map(n=><section id={`class-${n}`}><div class="class-bar"><h2 class="class-label">{n}반</h2><p>{projects.filter(p=>p.classroom===n).length}팀</p></div>{projects.filter(p=>p.classroom===n).sort((a,b)=>a.teamNumber-b.teamNumber).map(work=><article class="project-card"><p class="meta">2학년 {work.classroom}반 · {work.teamNumber}팀 · {work.team}</p><h2><a href={`${base}/exhibition/ai-data/${work.id}/`}>{work.title}</a></h2><p>{'problem' in work ? work.problem : work.question}</p><div class="actions"><a class="primary" href={`${base}/exhibition/ai-data/${work.id}/`}>프로젝트와 제작 이야기 →</a><a class="secondary" href={work.url} target="_blank" rel="noopener noreferrer">웹앱 체험 ↗</a></div></article>)}</section>)}
<p class="book-note">팀이 제출하고 교사가 확인한 내용을 공개합니다. 확인 결과는 각 팀의 기록이며, 기능이 모두 검증되었다는 인증은 아닙니다.</p>
</Layout>
<style>.project-card{padding:25px;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:24px}.project-card h2{margin:12px 0}.project-card p{line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}</style>
